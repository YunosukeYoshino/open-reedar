{
  "name": "open-reedar",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "description": "A quiet RSS reader with your own coding agents.",
  "type": "module",
  "main": "dist/electron.cjs",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun run build && bun src/main/dev.ts",
    "start": "bun run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "icons": "bun scripts/icons.ts",
    "dist:cli": "bun build --compile --minify src/cli/open-reedar.ts --outfile dist/open-reedar",
    "dist:mac": "bun run build && bun run icons && bun run dist:cli && electron-builder --mac --publish never",
    "dist:mac:signed": "bun run dist:mac --config electron-builder.signed.cjs",
    "checksums": "cd release && shasum -a 256 *.dmg *.zip > SHA256SUMS.txt"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "electron-updater": "6.8.9",
    "html-entities": "^2.6.0",
    "ipaddr.js": "^2.2.0",
    "linkedom": "0.18.13",
    "lucide-react": "^0.577.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-markdown": "^10.1.0",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.0",
    "semver": "7.7.3",
    "smol-toml": "^1.8.0",
    "xml2js": "0.6.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/semver": "7.7.1",
    "@types/xml2js": "0.4.14",
    "electron": "^42.0.0",
    "electron-builder": "26.15.3",
    "happy-dom": "^20.13.2",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "electron"
  ],
  "author": "Reedar contributors"
}
